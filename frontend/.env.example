# Finora Frontend — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Backend API base URL
# Development: Leave as-is. Vite proxy routes /api/* to this URL automatically.
# Production: Change to your deployed backend URL (e.g. https://api.finora.app/api)
VITE_API_URL=http://localhost:7777/api
